#include<bits/stdc++.h>
using namespace std;
void quickSort(vector<int>& arr, int low, int high){
    if(low>= high) return;
  int pivotIndex = high;
int l = low - 1;

for(int i = low; i < high; i++){
    if(arr[i] <= arr[pivotIndex])
        swap(arr[i], arr[++l]);
}
swap(arr[pivotIndex], arr[l+1]);
    quickSort(arr,low,l);
    quickSort(arr,l+2,high);
}

int main(){
    // vector<int> arr= {2,3,1,0,23,-12,-12,-34,-23};
    vector<int> arr= {2,3,1,0,-23,334,23,21,343,43,23,32};
    quickSort(arr,0,arr.size()-1);
    for(auto x:arr) cout<<x<<" ";
} 
