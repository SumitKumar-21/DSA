#include<bits/stdc++.h>
using namespace std;
void merge(vector<int> & arr,int low, int high){
    int mid = low+ (high-low)/2;
    int l = low ; int r = mid+1;
    vector<int> nums(high-low+1);
    int i= 0;
    while(l<= mid && r<= high){
        if(arr[l]<= arr[r]){
            nums[i]= arr[l]; i++; l++;
        }else{
            nums[i] = arr[r];
            r++; i++;
        }
    }
    while(l<= mid){
        nums[i]= arr[l]; 
        l++; i++;
    }
    while(r<= high){
        nums[i]= arr[r];
        r++; i++;
    }
    for(auto x: nums) {arr[low]= x; low++;}
}
void mergeSort(vector<int>& arr, int low, int high){
    if(low>= high) return;
    int mid = low+ (high - low) /2;
    mergeSort(arr,low, mid);
    mergeSort(arr,mid+1,high);
    merge(arr,low,high);
}
int main(){
     vector<int> arr= {2,3,1,0,23,-12,-12,-34,-23};
    // vector<int> arr= {2,3,1,0,-23,334,23,21,343,43,23,32};
    mergeSort(arr,0,arr.size()-1);
    for(auto x:arr) cout<<x<<" ";
}
